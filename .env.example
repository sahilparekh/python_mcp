# Example environment file for Docker deployment
# Copy this file to .env and update with your actual values

# Google Cloud Storage Configuration
GCS_BUCKET_NAME=your-actual-gcs-bucket-name

# Google Cloud Project (optional)
GOOGLE_CLOUD_PROJECT=your-project-id

# Google Cloud Authentication
# Option 1: Use service account key file
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json

# Option 2: Use Application Default Credentials (when running on GCP)
# This is automatically detected when running on Google Cloud Platform

# Application Configuration
# PORT=8000
# HOST=0.0.0.0

# Logging Configuration
# LOG_LEVEL=INFO
